# oMLX 本地推理环境变量
# cp .env.example .env 后按机型修改（勿提交 .env）

# 与 oMLX DMG 默认一致
OMLX_MODEL_DIR=$HOME/.omlx/models

OMLX_HOST=127.0.0.1
OMLX_PORT=8000
HF_ENDPOINT=https://hf-mirror.com

# --- 16GB Mac Mini 流畅默认（Qwen3.5-4B；详见 configs/mac-mini-16gb-fluent.md）---
OMLX_MEMORY_GUARD_GB=10
OMLX_MAX_PROCESS_MEMORY=12GB
OMLX_MAX_MODEL_MEMORY=10GB
OMLX_MAX_CONCURRENT_REQUESTS=2

# --- 16GB 跑 Qwen3.6-35B 2bit 时改用 ---
# OMLX_MEMORY_GUARD_GB=14.5
# OMLX_MAX_PROCESS_MEMORY=14GB
# OMLX_MAX_MODEL_MEMORY=12GB
# OMLX_MAX_CONCURRENT_REQUESTS=1

# --- M3 Pro 36GB 示例（跑 35B-A3B 时改用）---
# OMLX_MEMORY_GUARD_GB=28
# OMLX_MAX_PROCESS_MEMORY=30GB
# OMLX_MAX_MODEL_MEMORY=26GB
# OMLX_MAX_CONCURRENT_REQUESTS=2

OMLX_SSD_CACHE_DIR=$HOME/.omlx/cache

# 与 oMLX Admin 里 API Key 一致
# OMLX_API_KEY=

OMLX_DOWNLOAD_SOURCE=hf-mirror

OMLX_MODEL_4B=mlx-community/Qwen3.5-4B-OptiQ-4bit
OMLX_MODEL_9B=mlx-community/Qwen3.5-9B-OptiQ-4bit
OMLX_MODEL_35B=mlx-community/Qwen3.5-35B-A3B-OptiQ-4bit
# 16GB 可选：Qwen3.6-35B 最小 2bit（约 11GB）
OMLX_MODEL_36_2BIT=majentik/Qwen3.6-35B-A3B-RotorQuant-MLX-2bit

# brew 安装：0=稳定版；更推荐 DMG
OMLX_WITH_CUSTOM_KERNEL=0
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# OpenCode（./scripts/setup-opencode.sh / bootstrap.sh）
OPENCODE_MODEL=Qwen3.5-4B-OptiQ-4bit
NPM_REGISTRY=https://registry.npmmirror.com
# 安装 OpenCode 二进制若需翻墙，取消注释并改成你的本地代理：
# OPENCODE_PROXY=http://127.0.0.1:7890
# 禁止自动安装 OpenCode：OPENCODE_INSTALL=0
